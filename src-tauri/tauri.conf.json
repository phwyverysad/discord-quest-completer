{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Quest Completer",
  "version": "1.0.0",
  "identifier": "me.markterence.discordquestcompleter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Quest Completer",
        "width": 940,
        "height": 660,
        "minWidth": 800,
        "minHeight": 580,
        "decorations": false,
        "shadow": true,
        "maximized": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http:", 
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com data:"
      }
    }
  }, 
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ]
  }
}